<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto">
    <!-- Every screen talks to the existing API; chat additionally holds a
         websocket open, and the reader streams audio and PDFs. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Android 13+ asks the student before any notification can be posted;
         firebase_messaging requests it at runtime on first launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Hardware this app does not actually need.
         Android infers a required hardware feature from certain permissions,
         and Play then hides the app from every device that lacks it — the
         "Your device isn't compatible with this version" message. Razorpay
         pulls in NFC and READ_BASIC_PHONE_STATE (implying telephony, which
         would exclude every Wi-Fi-only tablet) and Play services pulls in
         USE_FINGERPRINT (implying a fingerprint sensor, which would exclude
         most budget phones). Declaring each one required="false" here, with
         tools:replace, overrides whatever a library says now or later: none of
         these are load-bearing, the app runs fine without any of them. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false"
        tools:replace="android:required"/>
    <uses-feature android:name="android.hardware.fingerprint" android:required="false"
        tools:replace="android:required"/>
    <uses-feature android:name="android.hardware.nfc" android:required="false"
        tools:replace="android:required"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"
        tools:replace="android:required"/>
    <uses-feature android:name="android.hardware.camera.any" android:required="false"
        tools:replace="android:required"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"
        tools:replace="android:required"/>
    <!-- Lets the app reach Chromebooks and other pointer-driven Android
         devices, which are otherwise filtered out by the touchscreen
         requirement Android assumes by default. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"
        tools:replace="android:required"/>

    <application
        android:label="PSC Tips And Tricks"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Where FCM files a notification that arrives with the app closed.
             Must match the channel PushService creates and the channel_id the
             API sends, or Android 8+ uses an unconfigurable fallback. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="psc_default" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher opens WhatsApp support and external links. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
