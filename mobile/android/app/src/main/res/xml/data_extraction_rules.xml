<?xml version="1.0" encoding="utf-8"?>
<!--
  Downloaded books are encrypted under a key held in the platform keystore, and
  that key is not backed up. Letting the ciphertext leave the device in a cloud
  or device-to-device transfer would only ever produce an unreadable copy, so
  the offline library and the keystore-backed preferences are excluded outright.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="offline_library" />
        <exclude domain="sharedpref" path="FlutterSecureStorage" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="offline_library" />
        <exclude domain="sharedpref" path="FlutterSecureStorage" />
    </device-transfer>
</data-extraction-rules>
