<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP stays blocked everywhere except the phone itself: just_audio's
     caching audio source streams lesson audio through a local proxy on
     127.0.0.1 while it saves the file for offline replay. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
