generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  STUDENT
  STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrderStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  /// Carried over from the legacy PHP app, which could cancel an order after
  /// payment. Distinct from FAILED (payment never succeeded) and from REFUNDED
  /// (money returned) so the historical record stays exact.
  CANCELLED
}

enum MockTestStatus {
  UPCOMING
  LIVE
  COMPLETED
}

enum BookmarkType {
  QUESTION
  CHAPTER
}

enum ChatMessageType {
  TEXT
  POLL
  IMAGE
  DOCUMENT
}

enum OAuthProvider {
  GOOGLE
  APPLE
}

model User {
  id                 String                @id @default(uuid())
  email              String                @unique
  password           String?
  name               String
  role               UserRole              @default(STUDENT)
  status             UserStatus            @default(ACTIVE)
  isPremium          Boolean               @default(false)
  avatarUrl          String?
  // The photo URL from the user's linked Google account, refreshed on every
  // Google sign-in. Kept separate from `avatarUrl` (the active profile
  // picture) so removing the active photo doesn't get silently undone the
  // next time the user signs in with Google, while still letting the profile
  // page offer "use my Google photo" as an explicit choice.
  googleAvatarUrl    String?
  phoneNumber        String?
  orders             Order[]
  submissions        QuizSubmission[]
  messages           ChatMessage[]
  notifications      Notification[]
  readingProgress    ReadingProgress[]
  bookmarks          Bookmark[]
  staffPermission    StaffPermission?      @relation("OwnPermission")
  grantedPermissions StaffPermission[]     @relation("GrantedByAdmin")
  mockTestEntries    MockTestParticipant[]
  createdMockTests   MockTest[]
  sentNotifications  Notification[]        @relation("NotificationSender")
  chatGroupMembers   ChatGroupMember[]
  chatGroupPins      ChatGroupPin[]
  chatGroupReads     ChatGroupRead[]
  oauthIdentities    OAuthIdentity[]
  // --- Legacy migration fields (PHP/MySQL app) ---
  /// Primary key this user had in the legacy `users` table. Kept as a
  /// reference only — the new app still issues its own uuid — so the migration
  /// can be re-run idempotently and legacy orders can be re-linked.
  legacyId           String?               @unique
  bio                String?               @db.Text
  gender             String?
  dateOfBirth        DateTime?
  lastLoginAt        DateTime?
  /// The complete original legacy row, verbatim (minus the password hash,
  /// which is stored in `password`). Nothing from the old database is dropped:
  /// columns with no first-class home here (remember_token, batch_id,
  /// preferences, address, …) remain readable from this blob.
  legacyData         Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([role, createdAt(sort: Desc)])
  @@index([phoneNumber])
}

model OAuthIdentity {
  id                String        @id @default(uuid())
  provider          OAuthProvider
  providerAccountId String
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

model StaffPermission {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation("OwnPermission", fields: [userId], references: [id], onDelete: Cascade)
  manageBooks         Boolean  @default(false)
  manageQuizzes       Boolean  @default(false)
  manageChat          Boolean  @default(false)
  manageCoupons       Boolean  @default(false)
  manageNotifications Boolean  @default(false)
  viewOrders          Boolean  @default(false)
  manageOrders        Boolean  @default(false)
  viewAnalytics       Boolean  @default(false)
  manageUsers         Boolean  @default(false)
  /// The YouTube video library (VideoExam → VideoChapter → Video). Separate
  /// from manageBooks: the two libraries are independent modules, so a staff
  /// member curating videos need not also be able to edit the e-book catalog.
  manageVideos        Boolean  @default(false)
  /// The standalone PDF library (PdfExam → PdfChapter → PdfDocument).
  managePdfs          Boolean  @default(false)
  manageStaff         Boolean  @default(false)
  manageAnnouncements Boolean  @default(false)
  grantedById         String?
  grantedBy           User?    @relation("GrantedByAdmin", fields: [grantedById], references: [id])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Book {
  id                  String            @id @default(uuid())
  title               String
  author              String
  description         String            @db.Text
  coverUrl            String
  pdfUrl              String?
  previewPdfUrl       String?
  previewPdfFileName  String?
  previewPdfSizeBytes Int?
  price               Float             @default(0)
  discountPercent     Float             @default(0)
  /// Always the effective, actually-charged price (price minus the discount).
  /// Persisted rather than derived so the checkout and order history read one
  /// authoritative number instead of each re-deriving the discount.
  finalPrice          Float             @default(0)
  category            String
  publicationYear     Int?
  /// Store-listing identifiers carried over from the previous app: the
  /// Play Store product / base-plan ids and the App Store product id.
  productId           String?
  appleId             String?
  basePlanId          String?
  subscriptionType    String            @default("FULL_TIME_ACCESS")
  isPremium           Boolean           @default(false)
  isPublished         Boolean           @default(true)
  /// Whether the book shows in the public/guest listing for signed-out users.
  visibleToGuests     Boolean           @default(false)
  downloadCount       Int               @default(0)
  orders              Order[]
  chapters            Chapter[]
  readingProgress     ReadingProgress[]
  // --- Legacy migration fields ---
  /// `book_id` this title had in the legacy app.
  legacyId            String?           @unique
  /// True for books that existed only in the legacy app and were never brought
  /// across. They exist purely so historical orders keep a valid book
  /// reference; they are unpublished, hidden from guests, and grant no access.
  isLegacyPlaceholder Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([isLegacyPlaceholder, createdAt(sort: Desc)])
  @@index([category])
}

model Chapter {
  id                   String            @id @default(uuid())
  bookId               String
  book                 Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  title                String
  description          String?           @db.Text
  orderIndex           Int               @default(0)
  isActive             Boolean           @default(true)
  textContent          String?           @db.Text
  youtubeUrl           String?
  audioUrl             String?
  audioDurationSeconds Int?
  pdfUrl               String?
  topics               Topic[]
  readingProgress      ReadingProgress[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model Topic {
  id                String            @id @default(uuid())
  chapterId         String
  chapter           Chapter           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title             String
  description       String?           @db.Text
  orderIndex        Int               @default(0)
  isActive          Boolean           @default(true)
  youtubeUrl        String?
  audioUrl          String?
  pdfUrl            String?
  subtopics         Subtopic[]
  readingProgress   ReadingProgress[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Subtopic {
  id                String          @id @default(uuid())
  topicId           String
  topic             Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title             String
  description       String?         @db.Text
  orderIndex        Int             @default(0)
  isActive          Boolean         @default(true)
  youtubeUrl        String?
  audioUrl          String?
  pdfUrl            String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model ReadingProgress {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId          String
  book            Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapterId       String?
  chapter         Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  topicId         String?
  topic           Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  progressPercent Float    @default(0)
  lastReadAt      DateTime @default(now())

  @@unique([userId, bookId])
}

model Bookmark {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceType BookmarkType
  referenceId   String
  createdAt     DateTime     @default(now())

  @@unique([userId, referenceType, referenceId])
}

model Quiz {
  id                              String           @id @default(uuid())
  title                           String
  category                        String
  folderName                      String?          @default("Root")
  accessType                      String           @default("FREE")
  isActive                        Boolean          @default(true)
  showCorrectAnswerAfterSelection Boolean          @default(true)
  // When set, the quiz stays invisible to students until this moment passes.
  // Stored as the ISO-8601 UTC string the admin form produces — fixed width
  // and always Zulu, so a lexicographic comparison against
  // `new Date().toISOString()` orders these exactly as timestamps would, and
  // the release gate needs no column migration.
  releaseDate                     String?
  topic                           String?
  totalQuestions                  Int              @default(0)
  durationMinutes                 Int              @default(30)
  isLiveMock                      Boolean          @default(false)
  isPremium                       Boolean          @default(false)
  price                           Float            @default(0)
  // Negative marking is a "for every N wrong answers, deduct M marks" rule
  // (default: every 3 wrong answers costs 1 mark), not a flat per-question
  // penalty — that's why it's two numbers instead of one. Disabled by default
  // for every quiz; the admin UI auto-enables it only when creating a premium
  // (paid) quiz.
  negativeMarkingEnabled          Boolean          @default(false)
  negativeMarkingEvery            Int              @default(3)
  negativeMarkingDeduct           Float            @default(1)
  // When false (the default) a submission's score is floored at 0. An admin
  // must opt in per-quiz to let a heavily negative-marked attempt end below 0.
  allowNegativeScore              Boolean          @default(false)
  passingMarks                    Float            @default(40)
  totalMarks                      Float            @default(100)
  questions                       Question[]
  submissions                     QuizSubmission[]
  orders                          Order[]
  mockTests                       MockTest[]
  createdAt                       DateTime         @default(now())
  updatedAt                       DateTime         @updatedAt

  @@index([isActive, createdAt(sort: Desc)])
  @@index([folderName])
  @@index([category])
  @@index([accessType])
}

model QuizFolder {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?  @db.Text
  orderIndex  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Question {
  id                 String   @id @default(uuid())
  quizId             String
  quiz               Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text               String   @db.Text
  options            Json // array of { id: string, text: string }
  correctOptionIndex Int
  explanation        String?  @db.Text
  marks              Float    @default(1)
  /// Position within the quiz (admin-defined, e.g. by drag-to-reorder). Every
  /// save recreates all questions in one transaction, so `createdAt` alone
  /// can't be trusted to break ties — Postgres resolves `now()` once per
  /// transaction, not once per row.
  order              Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([quizId, order])
  @@index([createdAt(sort: Desc)])
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model QuizSubmission {
  id               String        @id @default(uuid())
  quizId           String
  quiz             Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  attemptNumber    Int           @default(1)
  attemptStatus    AttemptStatus @default(COMPLETED)
  score            Float         @default(0)
  totalMarks       Float         @default(0)
  percentage       Float         @default(0)
  totalQuestions   Int           @default(0)
  passed           Boolean       @default(false)
  correctAnswers   Int           @default(0)
  wrongAnswers     Int           @default(0)
  unattempted      Int           @default(0)
  timeTakenSeconds Int           @default(0)
  answers          Json          @default("[]")
  startedAt        DateTime      @default(now())
  submittedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt
}

model MockTest {
  id           String                @id @default(uuid())
  title        String
  quizId       String
  quiz         Quiz                  @relation(fields: [quizId], references: [id], onDelete: Cascade)
  scheduledAt  DateTime
  status       MockTestStatus        @default(UPCOMING)
  createdById  String
  createdBy    User                  @relation(fields: [createdById], references: [id])
  participants MockTestParticipant[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model MockTestParticipant {
  id          String    @id @default(uuid())
  mockTestId  String
  mockTest    MockTest  @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  score       Float?
  rank        Int?
  submittedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([mockTestId, userId])
}

model Order {
  id                  String      @id @default(uuid())
  userId              String
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId              String?
  book                Book?       @relation(fields: [bookId], references: [id])
  quizId              String?
  quiz                Quiz?       @relation(fields: [quizId], references: [id])
  amount              Float
  currency            String      @default("INR")
  status              OrderStatus @default(PENDING)
  razorpayOrderId     String?
  razorpayPaymentId   String?
  // --- Legacy migration fields (PHP/MySQL app) ---
  /// Primary key this order had in the legacy `orders` table.
  legacyId            String?     @unique
  /// The human-facing legacy reference (e.g. ORD_1761235553_20_95), which is
  /// what support tickets and customer receipts quote.
  legacyOrderNumber   String?     @unique
  /// Legacy `book_id`, retained even when the book never came across.
  legacyBookId        String?
  /// Raw legacy `status` and `payment_status`, kept unmapped. The two
  /// disagreed on ~1.7k rows, so collapsing them into `status` alone would
  /// destroy the evidence needed to audit a disputed payment.
  legacyStatus        String?
  legacyPaymentStatus String?
  razorpaySignature   String?
  description         String?
  accessType          String?
  validTill           DateTime?
  paidAt              DateTime?
  /// The complete original legacy row, verbatim, including the full `metadata`
  /// JSON (Play Store purchase tokens, Apple transaction ids, signatures).
  legacyData          Json?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([userId, bookId, status])
  @@index([status, createdAt(sort: Desc)])
  @@index([razorpayPaymentId])
  @@index([razorpayOrderId])
}

model Coupon {
  id                String   @id @default(uuid())
  code              String   @unique
  discountPercent   Float
  maxDiscountAmount Float
  validTill         DateTime
  isActive          Boolean  @default(true)
  usageCount        Int      @default(0)
  createdAt         DateTime @default(now())
}

model ChatGroup {
  id                String            @id @default(uuid())
  name              String
  description       String            @default("") @db.Text
  category          String            @default("General")
  iconEmoji         String            @default("💬")
  /// Group profile picture; falls back to an initial avatar when empty.
  imageUrl          String?
  coverGradient     String            @default("from-amber-500/20 to-orange-600/20")
  isLocked          Boolean           @default(false)
  allowTextMessages Boolean           @default(true)
  allowPolls        Boolean           @default(true)
  type              String            @default("community")
  messages          ChatMessage[]
  members           ChatGroupMember[]
  pins              ChatGroupPin[]
  reads             ChatGroupRead[]
  createdAt         DateTime          @default(now())
}

model ChatGroupMember {
  id        String    @id @default(uuid())
  groupId   String
  group     ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String    @default("MEMBER")
  /// A blocked member keeps their row (so an admin can find and unblock them)
  /// but the group disappears from their community list entirely.
  isBlocked Boolean   @default(false)
  blockedAt DateTime?
  joinedAt  DateTime  @default(now())

  @@unique([groupId, userId])
  @@index([groupId, isBlocked])
}

model ChatGroupPin {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId   String
  group     ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([userId, groupId])
}

model ChatGroupRead {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId           String
  group             ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lastReadMessageId String?
  lastReadAt        DateTime  @default(now())

  @@unique([userId, groupId])
}

model ChatMessage {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName    String
  userAvatar  String?
  content     String          @db.Text
  room        String          @default("general")
  groupId     String?
  group       ChatGroup?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  messageType ChatMessageType @default(TEXT)
  mediaUrl    String?
  metadata    Json?
  createdAt   DateTime        @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  body      String   @db.Text
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  target    String   @default("all")
  sentById  String?
  sentBy    User?    @relation("NotificationSender", fields: [sentById], references: [id])
  isRead    Boolean  @default(false)
  type      String?  @default("ANNOUNCEMENT")
  createdAt DateTime @default(now())
}

model AnnouncementPopup {
  id        String   @id @default(uuid())
  title     String
  message   String   @db.Text
  imageUrl  String?
  isActive  Boolean  @default(true)
  startDate DateTime @default(now())
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- YouTube video library ---------------------------------------------------
// A browsable Exam → Chapter → Video folder tree, deliberately kept separate
// from the Book hierarchy: a Book's chapters are pages of a purchasable title,
// whereas these are free reference material organised by exam. Mixing them
// would force every video to hang off a book that doesn't exist.

model VideoExam {
  id          String         @id @default(uuid())
  title       String
  description String?        @db.Text
  orderIndex  Int            @default(0)
  isActive    Boolean        @default(true)
  chapters    VideoChapter[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model VideoChapter {
  id          String    @id @default(uuid())
  examId      String
  exam        VideoExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  title       String
  description String?   @db.Text
  orderIndex  Int       @default(0)
  isActive    Boolean   @default(true)
  videos      Video[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([examId])
}

model Video {
  id             String       @id @default(uuid())
  chapterId      String
  chapter        VideoChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title          String
  description    String?      @db.Text
  /// The canonical watch URL. The admin may paste any YouTube link shape
  /// (youtu.be, /shorts, /embed, a bare id); the API normalises all of them to
  /// this one form so stored links are predictable.
  youtubeUrl     String
  /// Parsed out of the pasted link on write. Everything the app renders — the
  /// embed player and the thumbnail — is derived from this id, so a malformed
  /// link is rejected at the API rather than producing a dead card.
  youtubeVideoId String
  /// Derived from `youtubeVideoId`, never uploaded. Stored rather than
  /// recomputed per render so the URL pattern lives in exactly one place.
  thumbnailUrl   String
  pdfUrl         String?
  pdfFileName    String?
  pdfSizeBytes   Int?
  orderIndex     Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([chapterId])
}

// --- PDF library -------------------------------------------------------------
// The same Exam → Chapter → content shape as the video library, as its own set
// of tables. The two modules are independent: an exam folder in one has no
// bearing on the other.

model PdfExam {
  id          String       @id @default(uuid())
  title       String
  description String?      @db.Text
  orderIndex  Int          @default(0)
  isActive    Boolean      @default(true)
  chapters    PdfChapter[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model PdfChapter {
  id          String        @id @default(uuid())
  examId      String
  exam        PdfExam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  title       String
  description String?       @db.Text
  orderIndex  Int           @default(0)
  isActive    Boolean       @default(true)
  documents   PdfDocument[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([examId])
}

model PdfDocument {
  id            String     @id @default(uuid())
  chapterId     String
  chapter       PdfChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title         String
  description   String?    @db.Text
  /// Public Supabase Storage URL. Nullable only in the window between creating
  /// the row and the upload completing — the admin UI always does both.
  fileUrl       String?
  /// The name the admin uploaded, kept for display and for the download
  /// filename; the stored object key is timestamped and sanitised.
  fileName      String?
  fileSizeBytes Int?
  orderIndex    Int        @default(0)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([chapterId])
}
