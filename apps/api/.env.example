# Database (Supabase Postgres — background jobs run via the pgmq extension
# on this same database, no separate broker needed)
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres?schema=public"

# Supabase Configuration (used server-side for file storage — book covers/PDFs/chapter audio)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Server Configuration
PORT=4000
NODE_ENV="development"

# JWT Authentication
JWT_SECRET="super-secret-psc-jwt-key-2026"
JWT_REFRESH_SECRET="super-secret-psc-refresh-jwt-key-2026"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Razorpay Integration
RAZORPAY_KEY_ID="rzp_test_sample_key"
RAZORPAY_KEY_SECRET="sample_razorpay_secret"

# Firebase FCM Push Notifications
FCM_SERVER_KEY="sample_fcm_server_key"

# Frontend URL (used to build OAuth redirect-back links)
FRONTEND_URL="http://localhost:3000"

# Google Sign-In — from Google Cloud Console > APIs & Services > Credentials
# Authorized redirect URI must be: http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# Apple Sign-In — from Apple Developer > Certificates, Identifiers & Profiles
# (requires a paid Apple Developer account; leave blank until ready — the app
# runs fine without these, "Continue with Apple" just shows a clear error)
APPLE_CLIENT_ID="your-apple-services-id"
APPLE_TEAM_ID="your-apple-team-id"
APPLE_KEY_ID="your-apple-key-id"
APPLE_PRIVATE_KEY="your-apple-private-key-with-\n-for-newlines"
APPLE_CALLBACK_URL="http://localhost:4000/auth/apple/callback"
