# Database (PostgreSQL database URL)
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres?schema=public"

# Supabase Configuration (used server-side for file storage — book covers/PDFs/chapter audio)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Server Configuration
PORT=4000
NODE_ENV="development"

# JWT Authentication
JWT_SECRET="super-secret-psc-jwt-key-2026"
JWT_REFRESH_SECRET="super-secret-psc-refresh-jwt-key-2026"

# Frontend URL (used to build OAuth redirect-back links)
FRONTEND_URL="http://localhost:3000"

# Google Sign-In — from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# Razorpay Payment Gateway Configuration
# Mode: "test" for Demo/Test Mode, "live" for Live Production Mode
RAZORPAY_MODE="test"
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Audio pipeline (AI noise removal + audio-to-PDF sync for the book reader).
# Binaries are installed via nixpacks.toml (ffmpeg, whisper-cpp); models are
# downloaded by apps/api/scripts/setup-audio-models.sh at build time into
# apps/api/models/. Defaults below match that script's output paths, so
# these only need to be set if you customize the install location.
FFMPEG_PATH="ffmpeg"
WHISPER_CPP_BINARY_PATH="./whisper.cpp/build/bin/whisper-cli"
RNNOISE_MODEL_PATH="./models/rnnoise-model.rnnn"
WHISPER_MODEL_PATH="./models/ggml-small.bin"
